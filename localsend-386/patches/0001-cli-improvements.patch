+package discovery
+
+import (
+	"net"
+
+	"github.com/tingkai-c/localsend-cli/internal/discovery/shared"
+)
+
+// isSelf reports whether a discovery announcement came from this machine, so it
+// is filtered out instead of being offered as a send target. A device finds its
+// own announcements because it joins the same multicast group it broadcasts to.
+//
+// Two signals, because either alone is insufficient:
+//   - the fingerprint this machine advertises (stable, and correct on a
+//     multi-homed box where the same device appears under several IPs);
+//   - any IP that belongs to a local interface (catches a peer answering on
+//     our address, and works even before the fingerprint is set).
+func isSelf(ip string, fingerprint string) bool {
+	own := shared.Message.Fingerprint
+	if fingerprint != "" && own != "" && fingerprint == own {
+		return true
+	}
+	return isLocalIP(ip)
+}
+
+// isLocalIP reports whether ip is assigned to one of this machine's interfaces.
+func isLocalIP(ip string) bool {
+	parsed := net.ParseIP(ip)
+	if parsed == nil {
+		return false
+	}
+	addrs, err := net.InterfaceAddrs()
+	if err != nil {
+		return false
+	}
+	for _, addr := range addrs {
+		if ipnet, ok := addr.(*net.IPNet); ok && ipnet.IP.Equal(parsed) {
+			return true
+		}
+	}
+	return false
+}
