 func (m dashboardTextInputModel) Value() string { return m.value }
 
+// setValue replaces the box contents, leaving the cursor at the end. Used when
+// the clipboard is read into the box.
+func (m *dashboardTextInputModel) setValue(value string) {
+	m.value = value
+	m.cursor = len(value)
+}
+
+// window renders the value as ONE line that fits in limit cells, scrolling so the
+// cursor stays visible. The panel wraps lines that are too long, and a wrapped
+// line loses its alignment and its own style — a long dropped path came out as two
+// differently coloured lines instead of one box.
+func (m dashboardTextInputModel) window(limit int) string {
+	if limit < 8 {
+		limit = 8
+	}
+	value, cursor := m.value, m.cursor
+	if cursor > len(value) {
+		cursor = len(value)
+	}
+	rendered := value[:cursor] + "_" + value[cursor:]
+	if len(rendered) <= limit {
+		return rendered
+	}
+
+	// One cell is always the cursor itself; the rest is context, biased to the
+	// left so you can see what you are typing, with a little kept on the right.
+	right := len(rendered) - cursor - 1
+	rightKeep := limit / 4
+	if rightKeep > right {
+		rightKeep = right
+	}
+	left := cursor
+	leftKeep := limit - 1 - rightKeep
+	hidden := left > leftKeep
+	if hidden {
+		leftKeep-- // the "…" marking the hidden left-hand side costs a cell
+	}
+	if leftKeep < 0 {
+		leftKeep = 0
+	}
+	visible := rendered[cursor-leftKeep : cursor+1+rightKeep]
+	if hidden {
+		return "…" + visible
+	}
+	return visible
+}
