+// looksLikePath reports whether the dashboard box was given a file name rather
+// than the text of a message, so a mistyped path is still reported as a missing
+// file instead of being sent as prose. Deliberately narrow: a sentence contains
+// spaces and rarely contains a slash.
+func looksLikePath(value string) bool {
+	if strings.HasPrefix(value, "~") || strings.ContainsAny(value, `/\`) {
+		return true
+	}
+	return !strings.Contains(value, " ") && filepath.Ext(value) != ""
+}
