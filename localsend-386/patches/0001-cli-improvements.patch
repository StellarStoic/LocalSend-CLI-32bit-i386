+func TestDashboardSendBoxAcceptsPastedText(t *testing.T) {
+	m := initialDashboardTextInputModel()
+
+	// A paste arrives as ONE KeyMsg holding the whole string. The old path-only
+	// character whitelist dropped it entirely, so pasting a sentence into the
+	// dashboard did nothing at all.
+	pasted := "meeting at 18:00, bring the adapter"
+	m, _ = m.Update(bubbletea.KeyMsg{Type: bubbletea.KeyRunes, Runes: []rune(pasted)})
+	if got := m.Value(); got != pasted {
+		t.Fatalf("pasted value = %q, want %q", got, pasted)
+	}
+
+	// Newlines and tabs reach us from multi-line clipboards and must not survive
+	// as control characters: the message goes out as a single line.
+	m, _ = m.Update(bubbletea.KeyMsg{Type: bubbletea.KeyRunes, Runes: []rune("a\nb\tc")})
+	if got := m.Value(); got != pasted+"a b c" {
+		t.Fatalf("after multi-line paste value = %q, want %q", got, pasted+"a b c")
+	}
+
+	// A single typed character still lands, and named keys carry no runes so
+	// they must not be inserted as text.
+	m, _ = m.Update(bubbletea.KeyMsg{Type: bubbletea.KeyRunes, Runes: []rune("!")})
+	before := m.Value()
+	m, _ = m.Update(bubbletea.KeyMsg{Type: bubbletea.KeyEscape})
+	if m.Value() != before {
+		t.Fatalf("escape key modified the value: %q -> %q", before, m.Value())
+	}
+}
