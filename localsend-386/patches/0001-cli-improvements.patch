+// sanitizeInput keeps typed and pasted input intact apart from control
+// characters: this box accepts the text of a message, so spaces, commas and
+// quotes have to survive. Newlines and tabs become spaces, because a message is
+// sent as a single line.
+func sanitizeInput(s string) string {
+	return strings.Map(func(r rune) rune {
+		switch r {
+		case '\n', '\r', '	':
+			return ' '
+		}
+		if r < 0x20 || r == 0x7f {
+			return -1
+		}
+		return r
+	}, s)
