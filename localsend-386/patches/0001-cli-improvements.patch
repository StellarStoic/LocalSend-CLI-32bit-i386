+// dashboardTextWidth is how many cells a line may occupy inside the panel before
+// lipgloss wraps it. A wrapped line loses both its alignment and its own style,
+// which is what made a long dropped path look like two differently coloured lines.
+// The panel's own chrome comes off the top: a rounded border (2) and Padding(1, 3)
+// on each side (6).
+func (m dashboardModel) dashboardTextWidth() int {
+	panelWidth := 64
+	if m.width > 0 {
+		panelWidth = m.width - 12
+		if panelWidth > 64 {
+			panelWidth = 64
+		}
+		if panelWidth < 36 {
+			panelWidth = 36
+		}
+	}
+	usable := panelWidth - 8
+	if usable < 16 {
+		usable = 16
+	}
+	return usable
+}
